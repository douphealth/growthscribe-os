# Lovable Cloud / Supabase — public client config
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-only (do NOT expose to client)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
LOVABLE_API_KEY="your-lovable-ai-key"
GOOGLE_SEARCH_CONSOLE_API_KEY="your-gsc-connection-key"
GOOGLE_PAGESPEED_API_KEY="your-pagespeed-api-key"

# Optional social publishing adapter. Keep all values server-side.
# Per-site Metricool blogId belongs in autonomy_policies.config.metricool_blog_id.
METRICOOL_TOKEN="your-metricool-rest-api-token"
METRICOOL_USER_ID="your-metricool-user-id"
